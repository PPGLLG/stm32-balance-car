{
    "configurations": [
        {
            "name": "STM32F103",
            "compilerPath": "arm-none-eabi-gcc",
            "intelliSenseMode": "gcc-arm",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Core/Include",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/include",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/CMSIS_RTOS_V2",
                "${workspaceFolder}/Middlewares/Third_Party/FreeRTOS/Source/portable/GCC/ARM_CM3",
                "${workspaceFolder}/Task",
                "${workspaceFolder}/App",
                "${workspaceFolder}/BSP/**"
            ],
            "defines": [
                "STM32F103xB",
                "USE_HAL_DRIVER",
                "CMSIS_device_header=\"stm32f1xx.h\"",
                "USE_CUSTOM_SYSTICK_HANDLER_IMPLEMENTATION=1"
            ],
            "cStandard": "c99"
        }
    ],
    "version": 4
}
